rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. User Profiles: Isolated to profile owner
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Room Bookings (Hotel Accommodations)
    // Synchronized across all customer and admin devices (phones, tablets, laptops)
    match /roomBookings/{bookingId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }

    // 3. Cafe & Kitchen Orders (Food & Beverage)
    // Synchronized across all devices so the admin board and kitchen display all live orders
    match /cafeOrders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }

    // 4. Table Reservations & Catering
    // Real-time access across all devices
    match /tableReservations/{resId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }

    // 5. Admin Notifications & Live Alerts
    // Live notification broadcast across devices for hotel administration
    match /adminNotifications/{notifId} {
      allow read, create, update, delete: if true;
    }

    match /emailNotifications/{emailId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }

    // 6. Strict Default Catch-All: Deny undefined paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
