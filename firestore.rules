rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'redwanredhood@gmail.com' ||
        request.auth.token.email.lower() == 'monazhoteladmin@gmail.com' ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
      );
    }

    // Room bookings collection
    match /roomBookings/{bookingId} {
      // Ordinary customers can submit a booking with required validated fields
      allow create: if request.resource.data.guestName is string
                    && request.resource.data.guestName.size() >= 2
                    && request.resource.data.checkInDate is string
                    && request.resource.data.checkOutDate is string
                    && request.resource.data.totalPrice is number
                    && request.resource.data.totalPrice >= 0;

      // Customer can get their single booking by unique reference ID; listing is strictly admin-only
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Food & beverage orders collection
    match /cafeOrders/{orderId} {
      // Ordinary customers can place valid dining or room service orders
      allow create: if request.resource.data.customerName is string
                    && request.resource.data.customerName.size() >= 2
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount >= 0;

      // Customer can track their single order by reference ID; listing is strictly admin-only
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Table reservations collection
    match /tableReservations/{resId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.date is string
                    && request.resource.data.phone is string;
      allow get: if true;
      allow list, update, delete: if isAdmin();
    }

    // Admin notifications outbox
    match /adminNotifications/{notifId} {
      allow create: if request.resource.data.subject is string
                    && request.resource.data.recipient is string;
      allow read, update, delete: if isAdmin();
    }

    // Outbound email notifications log
    match /emailNotifications/{emailId} {
      allow create: if request.resource.data.target is string;
      allow read, update, delete: if isAdmin();
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
