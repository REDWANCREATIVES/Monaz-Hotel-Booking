rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A user owns a document if their UID matches doc.userId
    // or if their authenticated email matches guestEmail, customerEmail, or email
    function isDocOwner(docData) {
      return isAuthenticated() && (
        (docData.userId != null && docData.userId == request.auth.uid) ||
        (docData.guestEmail != null && request.auth.token.email != null && docData.guestEmail.lower() == request.auth.token.email.lower()) ||
        (docData.customerEmail != null && request.auth.token.email != null && docData.customerEmail.lower() == request.auth.token.email.lower()) ||
        (docData.email != null && request.auth.token.email != null && docData.email.lower() == request.auth.token.email.lower())
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'redwanredhood@gmail.com' ||
          request.auth.token.email.lower() == 'monazhoteladmin@gmail.com'
        )) ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
      );
    }

    // 1. User Profiles collection:
    // Each user can ONLY read and write their own profile document. No other user can access it.
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 2. Room Bookings collection:
    // Each user can ONLY read, update, or cancel their own room bookings.
    // Placement is open to guests/users; unauthorized users cannot read or modify other bookings.
    // Admin retains full operational oversight.
    match /roomBookings/{bookingId} {
      allow create: if true;
      allow read: if isDocOwner(resource.data) || isAdmin();
      allow update, delete: if isDocOwner(resource.data) || isAdmin();
    }

    // 3. Cafe & Kitchen Orders collection:
    // Each user can ONLY read and manage their own orders.
    // No user can access or view another customer's orders.
    match /cafeOrders/{orderId} {
      allow create: if true;
      allow read: if isDocOwner(resource.data) || isAdmin();
      allow update, delete: if isDocOwner(resource.data) || isAdmin();
    }

    // 4. Table Reservations & Catering collection:
    // Each user can ONLY access and manage their own reservations.
    match /tableReservations/{resId} {
      allow create: if true;
      allow read: if isDocOwner(resource.data) || isAdmin();
      allow update, delete: if isDocOwner(resource.data) || isAdmin();
    }

    // 5. Admin Notifications & Internal Logs:
    // Only authorized hotel management can read, update, or delete notification alerts.
    match /adminNotifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /emailNotifications/{emailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 6. Strict Default Catch-All: Deny all read and write by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
